#!/bin/bash
# Installed as ~/.local/bin/osu-lazer, ahead of the pacman-owned /usr/bin/osu-lazer on PATH,
# so the `osu` launcher and the desktop entries reach it. Plays the game, then asks systemd
# to refresh the corpus once it closes.

# The player's audio setup: pin the graph to 48 kHz and clear any forced quantum, so the
# graph's own latency cap applies. Absent on any other machine, so it is optional.
[ -x ~/.local/bin/pw-force ] && RATE=48000 QUANTUM=0 ~/.local/bin/pw-force
# Change the monitor resolution and then restart OTD to apply the change to the tablet
[ -x ~/.local/bin/osu-mode ] && ~/.local/bin/osu-mode 1080
systemctl --user restart opentabletdriver.service

log=$(dirname "$(readlink -f "$0")")/session-log
started=$("$log" start)

# Key travel for the whole session, from doubletap's passive tracer (it reads the keyboard
# alongside the live daemon and changes nothing in the input path). The header anchors it on
# CLOCK_MONOTONIC and wall time and records the thresholds it was played under, so it can be
# lined up with replays later; nothing does that yet, this only makes sure the data exists.
# Reports only arrive while a key moves, so an idle session costs nothing.
here=$(dirname "$(readlink -f "$0")")
traces=$here/../../build/traces
stamp=$(date +%Y-%m-%dT%H-%M-%S)
mkdir -p "$traces/otd-settings"
trace=
if command -v doubletapd >/dev/null; then
    doubletapd -T 2>/dev/null > >(zstd -q -o "$traces/$stamp.csv.zst") &
    trace=$!
fi

# The cursor's twin: every position OpenTabletDriver's virtual tablet sends, on the same
# clock, for judging plays against the cursor the game actually saw rather than the replay's
# 60 Hz. The OTD settings it was played under are kept once per distinct content.
otd=~/.config/OpenTabletDriver/settings.json
if [ -f "$otd" ]; then
    sha=$(sha256sum "$otd" | cut -c1-64)
    [ -f "$traces/otd-settings/$sha.json" ] || cp "$otd" "$traces/otd-settings/$sha.json"
fi
"$here/cursor-trace" 2>/dev/null > >(zstd -q -o "$traces/$stamp.cursor.csv.zst") &
cursor=$!
# If the launcher itself is killed, do not leave the tracers running into the next session.
trap 'kill -INT $trace $cursor 2>/dev/null' HUP TERM

/usr/bin/osu-lazer "$@"
status=$?
# SIGINT is the tracer's clean stop: it flushes and exits, and zstd finishes on EOF.
kill -INT $trace $cursor 2>/dev/null; wait $trace $cursor 2>/dev/null
systemctl --user start --no-block corpus-sync.service
hyprctl reload
# Detached, so a question nobody answers never holds the launcher open.
setsid -f "$log" end "$started" >/dev/null 2>&1
exit $status
