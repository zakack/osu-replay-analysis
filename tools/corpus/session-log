#!/bin/bash
# One line per lazer session in build/sessions.jsonl: what the rig was doing that no replay
# records. Called by tools/corpus/osu-lazer as `session-log start` before the game and
# `session-log end <start-time>` after it.
#
# Automatic: the Dell's DDC state and the profile read from it, by preset code (VCP 14):
# x0c is "Game 1" (brightness 80, Dark Stabilizer 2/3, Response Time Extreme) and x05 is
# Standard (45, off, Fast), both read 2026-10-08. The Dell-specific codes are kept raw;
# they do not track the menu reliably (see below). --mfg DEL matters: a second
# monitor (Westinghouse) is display 1, and an unqualified ddcutil reads that one. The raw preset and Dell
# feature codes ride along unmapped, in case Dark Stabilizer turns out to live in one. And the
# PipeWire clock force. Asked: headphones or speakers, which share one analog output on the
# Scarlett and so leave no trace anywhere. Speakers sit ~0.6 m away, 1.7 ms more than
# headphones.
cd "$(dirname "$(readlink -f "$0")")/../.."
log=build/sessions.jsonl

ddc() { timeout 5 ddcutil --mfg DEL getvcp 10 14 DC E0 E1 E2 E3 F0 --brief 2>/dev/null | awk '{printf "%s%s", (NR>1?";":""), $0}'; }
pw() { pw-metadata -n settings 0 2>/dev/null | grep -oE "clock\.force-(quantum|rate)' value:'[0-9]+" | tr -d "'" | sed 's/ value:/=/' | paste -sd';'; }

case "$1" in
start)
    date -Iseconds
    printf '%s\t%s\n' "$(ddc)" "$(pw)" > build/.session-start
    ;;
end)
    started=$2
    IFS=$'\t' read -r ddc_state pw_state < build/.session-start 2>/dev/null
    # Wait for an answer for up to ten minutes; ignoring it records "unanswered".
    output=$(timeout 600 notify-send -a "osu! session" -u normal \
        -A headphones=Headphones -A speakers=Speakers \
        "What did you listen on?" "For the replay corpus. Ignore to skip." 2>/dev/null)
    [ -z "$output" ] && output=unanswered
    python3 - "$started" "$(date -Iseconds)" "$output" "$ddc_state" "$pw_state" >> "$log" <<'PY'
import json, sys
start, end, output, ddc, pw = sys.argv[1:]
import re
# The preset code names the profile; brightness is the fallback for one not seen yet.
preset = re.search(r"VCP 14 SNC (x[0-9a-f]+)", ddc)
b = re.search(r"VCP 10 C (\d+)", ddc)
profile = {"x0c": "game1", "x05": "standard"}.get(preset.group(1) if preset else "",
          ("gaming?" if int(b.group(1)) >= 70 else "standard?") if b else "unknown")
# No MPRT label: DC x05 / E2 x04 / F0 x00 read the same under MPRT and, on 2026-10-09,
# under Game 1 with Extreme restored by hand, while Game 1 + Extreme read x00 / x1e / x0d
# the day before. Those codes are recorded raw and not interpreted.
print(json.dumps({"start": start, "end": end, "output": output, "monitor": profile, "ddc": ddc, "pipewire": pw}))
PY
    ;;
esac
