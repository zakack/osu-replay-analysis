#!/bin/bash
# One line per lazer session in build/sessions.jsonl: what the rig was doing that no replay
# records. Called by tools/corpus/osu-lazer as `session-log start` before the game and
# `session-log end <start-time>` after it.
#
# Automatic: the Dell's DDC state and the profile read from it, by preset code (VCP 14):
# x0c is "Game 1" (brightness 80, Dark Stabilizer 2/3, Response Time Extreme) and x05 is
# Standard (45, off, Fast), both read 2026-10-08. The Dell-specific codes are kept raw;
# they do not track the menu reliably (see below). --mfg DEL matters: a second
# monitor (Westinghouse) is display 1, and an unqualified ddcutil reads that one. The raw preset and Dell
# feature codes ride along unmapped, in case Dark Stabilizer turns out to live in one. And the
# PipeWire clock force. Asked: headphones or speakers, which share one analog output on the
# Scarlett and so leave no trace anywhere. Speakers sit ~0.6 m away, 1.7 ms more than
# headphones.
cd "$(dirname "$(readlink -f "$0")")/../.."
log=build/sessions.jsonl

ddc() { timeout 5 ddcutil --mfg DEL getvcp 10 14 DC E0 E1 E2 E3 F0 --brief 2>/dev/null | awk '{printf "%s%s", (NR>1?";":""), $0}'; }
# The game's display mode: tools/display/osu-mode switches it before launch, so this is what
# the session was played at.
display() { hyprctl monitors -j 2>/dev/null | jq -r '[.[] | select(.focused)][0] | "\(.width)x\(.height)@\(.refreshRate|round)"' 2>/dev/null; }
# The global audio offset, from lazer's game.ini under the path storage.ini points at. Read at
# both ends, since lazer writes game.ini on exit, so a change during the session shows as
# start != end. Recorded hit error includes this offset.
offset() {
    local dir
    dir=$(sed -n 's/^FullPath *= *//p' ~/.local/share/osu/storage.ini 2>/dev/null)
    sed -n 's/^AudioOffset *= *//p' "${dir:-$HOME/.local/share/osu}/game.ini" 2>/dev/null
}
pw() { pw-metadata -n settings 0 2>/dev/null | grep -oE "clock\.force-(quantum|rate)' value:'[0-9]+" | tr -d "'" | sed 's/ value:/=/' | paste -sd';'; }

case "$1" in
start)
    date -Iseconds
    # Unit separator, not tab: tab is IFS whitespace, so read would collapse an empty field.
    printf '%s\x1f%s\x1f%s\x1f%s\n' "$(ddc)" "$(pw)" "$(display)" "$(offset)" > build/.session-start
    ;;
end)
    started=$2
    IFS=$'\x1f' read -r ddc_state pw_state display_state offset_start < build/.session-start 2>/dev/null
    # Wait for an answer for up to ten minutes; ignoring it records "unanswered".
    output=$(timeout 600 notify-send -a "osu! session" -u normal \
        -A headphones=Headphones -A speakers=Speakers \
        "What did you listen on?" "For the replay corpus. Ignore to skip." 2>/dev/null)
    [ -z "$output" ] && output=unanswered
    python3 - "$started" "$(date -Iseconds)" "$output" "$ddc_state" "$pw_state" "$display_state" "$offset_start" "$(offset)" >> "$log" <<'PY'
import csv, json, sys
start, end, output, ddc, pw, display, offset_start, offset_end = sys.argv[1:]
import re
# The preset code names the profile; brightness is the fallback for one not seen yet.
preset = re.search(r"VCP 14 SNC (x[0-9a-f]+)", ddc)
b = re.search(r"VCP 10 C (\d+)", ddc)
profile = {"x0c": "game1", "x05": "standard"}.get(preset.group(1) if preset else "",
          ("gaming?" if int(b.group(1)) >= 70 else "standard?") if b else "unknown")
# No MPRT label: DC x05 / E2 x04 / F0 x00 read the same under MPRT and, on 2026-10-09,
# under Game 1 with Extreme restored by hand, while Game 1 + Extreme read x00 / x1e / x0d
# the day before. Those codes are recorded raw and not interpreted.
# A setup-timeline row only when the mode played at differs from the last session that
# recorded one (read before this session's line is written); switching back to the
# desktop mode between sessions is not a setup change.
last = last_offset = None
for line in open("build/sessions.jsonl"):
    try:
        prev = json.loads(line)
    except ValueError:
        continue
    last = prev.get("display") or last
    last_offset = prev.get("audio_offset_end") or last_offset
row = {"start": start, "end": end, "output": output, "monitor": profile, "ddc": ddc,
       "pipewire": pw, "display": display}
if offset_start or offset_end:
    row["audio_offset_start"], row["audio_offset_end"] = offset_start, offset_end
print(json.dumps(row))
# The same for the global offset: a row when it moved during this session, or since the last
# session that recorded it.
offset_rows = []
if last_offset and offset_start and offset_start != last_offset:
    offset_rows.append(f"Global audio offset (game.ini AudioOffset) {last_offset} -> {offset_start} "
                       f"between sessions, before the one starting {start[11:16]}")
if offset_start and offset_end and offset_start != offset_end:
    offset_rows.append(f"Global audio offset (game.ini AudioOffset) {offset_start} -> {offset_end} "
                       f"during the session {start[11:16]}-{end[11:16]}; timing within it is not comparable")
if display and last and display != last:
    with open("setup-timeline.csv", "a", newline="") as f:
        csv.writer(f).writerow([start[:10], "", "display",
            f"Game played at {display} (was {last}) from the session starting {start[11:16]}",
            "build/sessions.jsonl (session-log, hyprctl)", "measured"])
if offset_rows:
    with open("setup-timeline.csv", "a", newline="") as f:
        for text in offset_rows:
            csv.writer(f).writerow([start[:10], "", "audio", text,
                "build/sessions.jsonl (session-log, game.ini)", "measured"])
PY
    ;;
esac
