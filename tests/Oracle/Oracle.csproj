<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The differential oracle. This project deliberately does what the pipeline must never do:
    it stands up a real osu!framework game host and plays replays through lazer's actual
    ReplayPlayer, so that Sim's reimplemented judgement loop can be diffed against the
    reference per object.

    It is quarantined here on purpose. Nothing under src/ may reference it, and its BASS,
    SDL and Veldrid dependencies are the reason HostGuard exists. Non-commercial use is what
    makes hosting the game legal at all.
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="NUnit" Version="4.5.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Extract\Extract.csproj" />
    <ProjectReference Include="..\..\ppy\osu\osu.Game.Rulesets.Osu\osu.Game.Rulesets.Osu.csproj" />
  </ItemGroup>

</Project>
